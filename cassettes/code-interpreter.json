        "content": [
          "The failure is on 'Hello,   World': replacing each space separately leaves a run of hyphens. Collapsing whitespace first and squeezing repeated hyphens fixes it.",
          "",
          "```python",
          "import re",
          "",
          "",
          "def slugify(text):",
          "    text = text.lower()",
          "    text = re.sub(r\"[\\s_]+\", \"-\", text)      # spaces/underscores -> hyphen",
          "    text = re.sub(r\"[^a-z0-9-]\", \"\", text)   # drop everything else",
          "    text = re.sub(r\"-{2,}\", \"-\", text)       # collapse repeated hyphens",
          "    return text.strip(\"-\")",
          "",
          "",
          "assert slugify(\"Hello World\") == \"hello-world\"",
          "assert slugify(\"snake_case_name\") == \"snake-case-name\"",
          "assert slugify(\"Already-a-slug\") == \"already-a-slug\"",
