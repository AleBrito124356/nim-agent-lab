# NVIDIA NIM API key (required for live runs; --offline needs none).
# Free: go to https://build.nvidia.com, sign up, open any model card,
# click "Get API Key" and copy the key. It starts with "nvapi-".
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXX

# Chat model id (optional). Any chat model listed on build.nvidia.com works.
# Defaults to meta/llama-3.3-70b-instruct if unset.
NIM_MODEL=meta/llama-3.3-70b-instruct

# Endpoint (optional). Point the lab at a self-hosted NIM container instead of
# the hosted API, e.g. http://localhost:8000/v1
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# No key yet? Every pattern runs offline from a cassette, without this file:
#   python main.py react --offline
